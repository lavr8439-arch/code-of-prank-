# Визначення стабільної теки для збереження відео на ПК (Папка "Відео" або Home)
user_videos_dir = Path.home() / "Videos"
if not user_videos_dir.exists():
    user_videos_dir = Path.home()

LOCAL_VIDEO_PATH = str(user_videos_dir / "rickroll.mp4")
PARTIAL_VIDEO_PATH = LOCAL_VIDEO_PATH + ".download"

download_event = threading.Event()
download_success = False


def download_video_worker():
    """Фонове завантаження відео прямо на ПК."""
    global download_success

    # Якщо файл вже завантажений і валідний (> 1 MB)
    if os.path.exists(LOCAL_VIDEO_PATH) and os.path.getsize(LOCAL_VIDEO_PATH) > 1024 * 1024:
        download_success = True
        download_event.set()
        return

    headers = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        )
    }

    for url in VIDEO_SOURCES:
        try:
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=40) as response, open(PARTIAL_VIDEO_PATH, "wb") as out_file:
                shutil.copyfileobj(response, out_file)

            if os.path.exists(LOCAL_VIDEO_PATH):
                os.remove(LOCAL_VIDEO_PATH)
            os.rename(PARTIAL_VIDEO_PATH, LOCAL_VIDEO_PATH)

            download_success = True
            break
        except Exception:
            if os.path.exists(PARTIAL_VIDEO_PATH):
                try:
                    os.remove(PARTIAL_VIDEO_PATH)
                except OSError:
                    pass

    download_event.set()


# Запуск фонового завантаження
download_thread = threading.Thread(target=download_video_worker, daemon=True)
download_thread.start()


def play_local_video(video_path: str):
    """Відтворення завантаженого локального відео на повний екран."""
    if not os.path.exists(video_path):
        return

    # Спроба запуску через браузери у повноекранному режимі кіоску з увімкненим звуком
    browsers = [
        os.path.expanduser(r"~\AppData\Local\Google\Chrome\Application\chrome.exe"),
        r"C:\Program Files\Google\Chrome\Application\chrome.exe",
        r"C:\Program Files (x86)\Google\Chrome\Application\chrome.exe",
        r"C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe",
        r"C:\Program Files\Microsoft\Edge\Application\msedge.exe",
        shutil.which("chrome") or "",
        shutil.which("msedge") or "",
    ]

    selected_browser = next((b for b in browsers if b and os.path.isfile(b)), None)

    if selected_browser:
        file_url = Path(video_path).resolve().as_uri()
        args = [
            selected_browser,
            "--kiosk",
            "--autoplay-policy=no-user-gesture-required",
            "--no-first-run",
            "--disable-sync",
            file_url,
        ]
        try:
            subprocess.Popen(args)
            return
        except Exception:
            pass

    # Спроба запуску через Windows Media Player
    wmplayer = r"C:\Program Files\Windows Media Player\wmplayer.exe"
    if os.path.isfile(wmplayer):
        try:
            subprocess.Popen([wmplayer, "/fullscreen", video_path])
            return
        except Exception:
            pass

    # Стандартний системний відеоплеєр за замовчуванням
    if sys.platform == "win32":
        os.startfile(video_path)
    elif sys.platform == "darwin":
        subprocess.Popen(["open", video_path])
    else:
        subprocess.Popen(["xdg-open", video_path])


def finalize_and_play():
    """Перевіряє наявність файлу та запускає його."""
    if download_success and os.path.exists(LOCAL_VIDEO_PATH):
        play_local_video(LOCAL_VIDEO_PATH)


