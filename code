def render_dot_text(text: str) -> str:
    rendered = []
    for text_line in text.upper().splitlines():
        rows = [""] * 7
        for character in text_line:
            glyph = DOT_FONT.get(character, DOT_FONT[" "])
            rows = [
                row + "".join("." if pixel == "1" else " " for pixel in glyph[index]) + " "
                for index, row in enumerate(rows)
            ]
        rendered.extend(row.rstrip() for row in rows)
        rendered.append("")
    return "\n".join(rendered).rstrip()


