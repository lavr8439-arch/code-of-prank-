def wait_for_download_and_trigger():
    """Чекає завершення завантаження файлу на диск без переходу на сторонні ресурси."""
    if download_event.is_set():
        root.destroy()
        finalize_and_play()
    else:
        countdown_label.config(text="LOADING...", font=("Segoe UI", 32, "bold"))
        root.after(300, wait_for_download_and_trigger)


def start_countdown(seconds: int = 15):
    global timer_job
    countdown_label.config(text=str(seconds))
    if seconds > 0:
        timer_job = root.after(1000, start_countdown, seconds - 1)
    else:
        # Таймер закінчився: перевіряємо чи файл готовий
        wait_for_download_and_trigger()


def on_escape(event=None):
    global timer_job
    if timer_job:
        root.after_cancel(timer_job)
    root.destroy()


root.after(0, start_countdown)
root.bind("<Escape>", on_escape)
root.mainloop()
